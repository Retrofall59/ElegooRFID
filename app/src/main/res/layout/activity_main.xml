<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_clair"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_bobine"
                android:contentDescription="Logo bobine" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="ElegooRFID"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texte_principal" />

            <ImageButton
                android:id="@+id/btnParametres"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_parametres"
                android:contentDescription="Parametres" />
        </LinearLayout>

        <!-- Bandeau d'avertissement : texte statique (aucune bascule de visibilite dans le code,
             malgre ce qu'un ancien commentaire laissait croire) - mis a jour a la main a chaque
             fois qu'un champ passe de "non confirme" a "confirme". Voir CHANGELOG.md. -->
        <TextView
            android:id="@+id/bandeauNonValide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/fond_carte"
            android:padding="10dp"
            android:text="✅ Tous les champs connus (couleur, poids, diamètre, matière, sous-type, température buse, date de fabrication) sont confirmés, sur de vraies bobines ou via l'éditeur open-source elegoo-rfid-editor."
            android:textColor="@color/texte_secondaire"
            android:textSize="12sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnReglagesNfc"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/fond_bouton_principal"
            android:text="NFC désactivé - ouvrir les réglages"
            android:textColor="@color/carte_blanc"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:visibility="gone" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/carte_blanc">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:background="@drawable/barre_accent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/imgNfc"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/ic_nfc"
                        android:contentDescription="Icone NFC"
                        android:layout_marginBottom="10dp" />

                    <View
                        android:id="@+id/vuCouleur"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginBottom="14dp"
                        android:visibility="gone"
                        android:background="@drawable/forme_couleur" />

                    <TextView
                        android:id="@+id/txtStatut"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Approche une bobine Elegoo du dos du telephone..."
                        android:textColor="@color/texte_principal"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:id="@+id/layoutLignesInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnCloner"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/fond_bouton_principal"
            android:text="Cloner sur une bobine vierge"
            android:textColor="@color/carte_blanc"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnAnnulerClonage"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/fond_bouton_secondaire"
            android:text="Annuler le clonage"
            android:textColor="@color/elegoo_noir"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnExporter"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/fond_bouton_secondaire"
            android:text="Exporter le dernier dump"
            android:textColor="@color/elegoo_noir"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <!-- Import (ajoute le 08/10/2026) : permet de charger un dump exporte precedemment
             (depuis n'importe quel appareil) sans avoir besoin de la bobine source physique au
             moment du clonage - utile pour cloner plus tard, ou cloner a partir d'une bobine
             qu'on a seulement scannee chez quelqu'un d'autre. -->
        <Button
            android:id="@+id/btnImporterDump"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/fond_bouton_secondaire"
            android:text="Importer un dump pour cloner"
            android:textColor="@color/elegoo_noir"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:weightSum="3">

            <Button
                android:id="@+id/btnCopier"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/fond_bouton_secondaire"
                android:text="Copier"
                android:textColor="@color/elegoo_noir"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPartager"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/fond_bouton_secondaire"
                android:text="Partager"
                android:textColor="@color/elegoo_noir"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnHistorique"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/fond_bouton_secondaire"
                android:text="Historique"
                android:textColor="@color/elegoo_noir"
                android:textAllCaps="false"
                android:textSize="12sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnRapportCompat"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/fond_bouton_secondaire"
            android:text="Copier le rapport de compatibilité"
            android:textColor="@color/elegoo_noir"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <!-- Effacement : disponible a tout moment (pas besoin d'avoir scanne une bobine valide
             au prealable, contrairement au clonage) - utile pour reinitialiser un tag deja
             ecrit (test precedent, ou ancien clonage) avant de le recloner proprement. Couleur
             d'avertissement : action destructrice et irreversible. -->
        <Button
            android:id="@+id/btnEffacer"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/fond_bouton_secondaire"
            android:text="Effacer un tag"
            android:textColor="@color/rouge_attention"
            android:textAllCaps="false"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
